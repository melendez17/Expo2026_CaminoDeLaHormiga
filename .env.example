# Solo servidor; nunca utilizar NEXT_PUBLIC para la clave de servicio.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER=
# Origen HTTPS de producción (para verificación de solicitudes mutantes).
APP_ORIGIN=http://localhost:3000
# Solo habilitar si el proxy elimina y reemplaza x-forwarded-for de clientes.
TRUST_PROXY=false
