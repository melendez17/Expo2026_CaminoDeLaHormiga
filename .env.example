# DEMO: the current UI stays local until its API adapter is connected.
# Production endpoints fail closed unless this flag and the configuration exist.
CAMINO_BACKEND_ENABLED=false
# Server only. Never prefix a service key with NEXT_PUBLIC.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Independent secrets: generate each with crypto.randomBytes(32).toString('hex').
TOKEN_PEPPER=
APP_ENCRYPTION_KEY=
# Exact origin, no trailing slash. HTTPS is mandatory in NODE_ENV=production.
APP_ORIGIN=http://localhost:3000
PARTICIPANT_SESSION_SECONDS=43200
# MFA is mandatory in production regardless of this development override.
ADMIN_REQUIRE_MFA=true
# Set true only if a trusted proxy REPLACES x-forwarded-for.
TRUST_PROXY=false
# Optional participant email delivery. Disabled until SMTP and the job are ready.
EMAIL_ACCESS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Bearer credential for POST /api/v1/internal/jobs; generate independently.
JOBS_SECRET=
